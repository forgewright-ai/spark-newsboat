#!/bin/sh
# spark-newsboat -- the article, in the room with spark. Two laws, one
# screen: Enter alone is the OVERVIEW (`spark read`, the verdict law:
# every line quotes the article or the reply is an honest refusal);
# your words are a CONVERSATION (`spark edit ?` with a thread, the
# conversation law: follow-ups ride the earlier turns, so "can you translate
# that?" has a that; a quote the article does not hold is marked
# [not in the text] where it stands instead of being silenced).
#
# --ask is the macro's mode (,s in newsboat): newsboat pipes the
# article in and hands the terminal over until the command returns,
# repainting after -- so the whole screen is ours for the exchange.
# Where the terminal has an alternate screen (every emulator; the Linux
# console ignores the sequence and newsboat repaints anyway) the
# article list is untouched underneath. Ctrl-C is never mind. The
# words never glob (set -f) and never touch the article.
#
# The answer is revealed at a reader's pace when this spark has
# `spark reveal` (1.31 or newer): each grounded line appears letter by
# letter (SPARK_REVEAL_CPS sets the speed), so the model composing the
# next line hides behind the reading of this one. An older spark shows
# each line whole as it clears the gate. The wrap is a line-flushing
# awk, not fold: fold holds lines back in a pipe, and a paced reveal
# needs each line the moment the gate frees it.
W=${SPARK_NEWSBOAT_WIDTH:-78}

wrapw() {
    awk -v w="$W" '{ line = $0
        while (length(line) > w) {
            i = w + 1
            while (i > 1 && substr(line, i, 1) != " ") i--
            if (i <= 1) i = w
            print substr(line, 1, i); line = substr(line, i + 1)
        }
        print line; fflush() }'
}

# The pulse: the wait says what it is, conversationally -- "reading N
# characters" the first time (the model takes the article in),
# "thinking" on every turn after (the article is already in the
# thread). Spin, count the seconds, erase the line the moment the
# first answer byte arrives. ASCII frames only: the box console
# draws nothing fancier.
pulse_start() {
    P_T0=$(date +%s)
    ( n=0
      while :; do
          case $((n % 4)) in
              0) f='|' ;; 1) f='/' ;; 2) f='-' ;; 3) f='\' ;;
          esac
          printf '\r\033[2K%s  %s %ss' \
              "$1" "$f" "$(( $(date +%s) - P_T0 ))" > /dev/tty
          n=$((n + 1))
          sleep 0.25
      done ) 2>/dev/null &
    PULSE=$!
}

pulse_stop() {
    [ -z "${PULSE-}" ] || kill "$PULSE" 2>/dev/null
    PULSE=
    printf '\r\033[2K' > /dev/tty
}

# read fills its variable even when the stream ends without a final
# newline, but returns nonzero -- a one-line answer with no trailing
# newline (spark edit streams raw) must not be mistaken for silence.
answer() {
    if spark reveal -h >/dev/null 2>&1; then
        "$@" 2>&1 | {
            IFS= read -r first; r=$?
            [ -n "$first" ] || [ $r -eq 0 ] || { pulse_stop; exit 0; }
            pulse_stop
            { printf '%s\n' "$first"; cat; } | wrapw | spark reveal
        }
    else
        "$@" 2>&1 | {
            IFS= read -r first; r=$?
            [ -n "$first" ] || [ $r -eq 0 ] || { pulse_stop; exit 0; }
            pulse_stop
            { printf '%s\n' "$first"; cat; } | wrapw
        }
    fi
}

case ${1-} in
    --ask)
        art=$(cat)
        # does this spark advertise --source (the reading-discussion
        # posture, 1.32+)? probe once; empty means an older spark and
        # the conversation runs exactly as before.
        SOURCE=
        spark edit -h 2>/dev/null | grep -q -- --source && SOURCE=yes
        # the room's width: the terminal's, within reading reason
        if [ -z "${SPARK_NEWSBOAT_WIDTH-}" ]; then
            set -- $(stty size < /dev/tty 2>/dev/null || echo "0 80")
            W=$(( ${2:-80} - 2 ))
            [ "$W" -gt 100 ] && W=100
            [ "$W" -lt 40 ] && W=78
        fi
        B="$(printf '\033[1m')"; C="$(printf '\033[36m')"; R="$(printf '\033[0m')"
        # the header newsboat composed -- Feed, Title, Author, Date,
        # Link -- shown whole, so the reader never leaves this screen
        # to remember what they are asking about
        header=$(printf '%s\n' "$art" \
                 | awk 'NR > 12 || /^$/ { exit } /^(Feed|Title|Author|Date|Link|Podcast): / { print }')
        title=$(printf '%s\n' "$header" | sed -n 's/^Title: //p' | head -n 1)
        thread="nb-$(date +%s)-$$"
        # a stub: a link feed carries a headline and pointers, not the
        # story -- fewer than 120 non-space characters once the URLs
        # are set aside. Say so instead of earning a confusing refusal;
        # words still ask, Enter returns.
        stub=
        body=$(printf '%s\n' "$art" \
               | awk 'h == 0 && /^(Feed|Title|Author|Date|Link|Podcast): / { next } { h = 1; print }' \
               | sed 's|https\{0,1\}://[^ ]*||g')
        [ "$(printf %s "$body" | tr -d '[:space:]' | wc -c | tr -d ' ')" -lt 120 ] && stub=yes
        old=$(stty -g < /dev/tty 2>/dev/null || true)
        trap '[ -z "${PULSE-}" ] || kill "$PULSE" 2>/dev/null; printf "\033[?1049l" > /dev/tty; [ -z "$old" ] || stty "$old" < /dev/tty; exit 130' INT
        [ -z "$old" ] || stty sane < /dev/tty
        printf '\033[?1049h\033[2J\033[H' > /dev/tty
        feed=$(printf '%s\n' "$header" | sed -n 's/^Feed: //p' | head -n 1)
        author=$(printf '%s\n' "$header" | sed -n 's/^Author: //p' | head -n 1)
        adate=$(printf '%s\n' "$header" | sed -n 's/^Date: //p' | head -n 1)
        link=$(printf '%s\n' "$header" | sed -n 's/^Link: //p' | head -n 1)
        [ -z "$title" ] || printf '%s%s%s\n' "$B" "$title" "$R" > /dev/tty
        meta=$feed
        [ -z "$author" ] || meta="$meta -- $author"
        [ -z "$adate" ] || meta="$meta -- $adate"
        [ -z "$meta" ] || printf '%s%s%s\n' "$C" "$meta" "$R" > /dev/tty
        [ -z "$link" ] || printf '%s%s%s\n' "$C" "$link" "$R" > /dev/tty
        printf '%s\n' "$(printf '%*s' "$W" "" | tr " " "-")" > /dev/tty
        printf "\nhello %s -- let's talk about it.\n\n" "${USER:-there}" > /dev/tty
        [ -z "$stub" ] || printf 'this feed carried only a stub -- o opens the story in w3m; M-s asks there\n\n' > /dev/tty
        # the exchange is a loop: another question of the same article
        # costs no trip back to newsboat. The first Enter alone is the
        # overview (on a stub it returns: nothing to overview); after
        # an answer, Enter alone returns to newsboat.
        asked=
        while :; do
            printf '%schat>%s ' "$B" "$R" > /dev/tty
            IFS= read -r q < /dev/tty || break
            # the family's quit grammar (spark chat's QUIT_WORDS, plus
            # newsboat's own q): a quit word must never reach the
            # model, which would role-play an exit -- the first-session
            # trap the chat REPL learned first
            case $q in
                q|/q|/quit|/exit|:q|:quit|:wq|quit|exit|bye) break ;;
            esac
            if [ -z "$q" ]; then
                [ -z "$asked" ] && [ -z "$stub" ] || break
            fi
            case $q in "?"*) q=${q#?} ;; esac
            set -f
            set -- $q
            set +f
            if [ $# -eq 0 ]; then
                # the overview: the verdict law, one grounded answer
                set -- spark read
            else
                # the conversation: the conversation law, threaded follow-ups.
                # --source (spark 1.32+) picks the reading-discussion posture
                # so a published article is discussed, not reviewed as a
                # draft -- guarded, so an older spark is unchanged.
                set -- '?' "$@" --thread "$thread" --about "a news article"
                [ -z "$title" ] || set -- "$@" --name "$title"
                [ -z "$SOURCE" ] || set -- "$@" --source
                set -- spark edit "$@"
            fi
            printf '\n' > /dev/tty
            if [ -z "$asked" ]; then
                pulse_start "reading $(printf %s "$art" | wc -c | tr -d ' ') characters"
            else
                pulse_start "thinking"
            fi
            printf '%s\n' "$art" | answer "$@" > /dev/tty
            [ -z "${PULSE-}" ] || kill "$PULSE" 2>/dev/null
            printf '\n\n' > /dev/tty
            asked=yes
        done
        printf '\033[?1049l' > /dev/tty
        trap - INT
        [ -z "$old" ] || stty "$old" < /dev/tty
        exit 0
        ;;
esac
spark read "$@" 2>&1 | wrapw
